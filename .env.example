# CivicPulse - Civic Issue Reporting & Municipal Management
# Company: Zenith Stack

# Groq Fast LLM & Speech API (Whisper-large-v3, Qwen 3.8, GPT-OSS)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="qwen/qwen3.8-27b"

# Cerebras Cloud Platform (Secondary AI)
CEREBRAS_API_KEY="your_cerebras_api_key_here"
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"

# Cloudflare Workers AI Token
CLOUDFLARE_API_KEY="your_cloudflare_token_here"

# Official Municipal Guidelines & Information Search APIs
SERPAPI_API_KEY="your_serpapi_key_here"
ZENSERP_API_KEY="your_zenserp_key_here"

# Supabase Backend (PostgreSQL, Storage, Realtime, Auth)
VITE_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PROJECT_NAME="your_supabase_project"
SUPABASE_DB_PASSWORD="your_database_password"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Organization Metadata
VITE_COMPANY_NAME="Zenith Stack"
