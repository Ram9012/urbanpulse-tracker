# CivicPulse - Civic Issue Reporting & Municipal Management
# Company: Zenith Stack

# Groq Fast LLM & Speech API (Whisper-large-v3, Qwen 3.8, GPT-OSS)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="qwen/qwen3.8-27b"

# Cerebras Cloud Platform (Secondary AI)
CEREBRAS_API_KEY="your_cerebras_api_key_here"
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"

# Cloudflare Workers AI Token
CLOUDFLARE_API_KEY="your_cloudflare_token_here"

# Official Municipal Guidelines & Information Search APIs
SERPAPI_API_KEY="your_serpapi_key_here"
ZENSERP_API_KEY="your_zenserp_key_here"

# Supabase Backend (PostgreSQL, Storage, Realtime)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PROJECT_NAME="your_supabase_project"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_STORAGE_BUCKET="report-media"

# Admin bootstrap — the admin account's password is hashed from this at
# startup. Set a real value in every environment; do not commit one.
ADMIN_SEED_PASSWORD="change_me"

# Signs session cookies (login/admin checks). Set a long random value in
# every environment — without it, sessions don't survive a server restart.
SESSION_SECRET="change_me_to_a_long_random_string"

# Organization Metadata
VITE_COMPANY_NAME="Zenith Stack"
