# CivicPulse AI Microservice Environment Configuration

# Server Settings
AI_SERVICE_NAME="CivicPulse AI Verification Service"
AI_HOST="0.0.0.0"
AI_PORT=8001
AI_DEBUG=false

# Service-to-Service Secret Authentication Token
AI_API_SECRET_KEY="civicpulse-ai-secret-change-in-production"

# Image Processing Limits
AI_MAX_IMAGE_SIZE_BYTES=15728640
AI_PROCESSING_RESOLUTION=512

# Verification Score Weights & Thresholds
AI_WEIGHT_SCENE_CONSISTENCY=0.30
AI_WEIGHT_SIAMESE_SIMILARITY=0.25
AI_WEIGHT_BIDIRECTIONAL=0.20
AI_WEIGHT_SEGMENTATION=0.15
AI_WEIGHT_QUALITY=0.10

AI_FINAL_VERIFIED_THRESHOLD=0.60
AI_FINAL_NEEDS_REVIEW_THRESHOLD=0.40
AI_PHASH_DUPLICATE_THRESHOLD=10

# Processing Controls
AI_MAX_RETRIES=3
AI_JOB_TIMEOUT_SECONDS=120

